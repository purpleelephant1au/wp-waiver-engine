{
    "name": "waiver-engine/waiver-engine",
    "description": "WordPress Waiver Engine - PDF overlay generation",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0",
        "freemius/wordpress-sdk": "^2.13.4",
        "setasign/fpdi": "^2.6.8",
        "setasign/fpdf": "^1.9"
    },
    "autoload": {
        "classmap": [
            "includes/class-core.php",
            "includes/class-cpt-registration.php",
            "includes/class-database.php",
            "includes/class-admin-menu.php",
            "includes/class-admin-entry-list.php",
            "includes/class-entry-list-table.php",
            "includes/class-entry-detail.php",
            "includes/class-entry-handler.php",
            "includes/class-template-editor.php",
            "includes/class-template-meta-box.php",
            "includes/class-form-renderer.php",
            "includes/class-pdf-generator.php",
            "includes/class-settings.php",
            "includes/class-license.php",
            "includes/class-license-provider-interface.php",
            "includes/class-license-provider-null.php",
            "includes/class-license-provider-freemius.php",
            "includes/class-plan.php",
            "includes/class-integration-manager.php",
            "includes/class-uninstall.php"
        ]
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "platform": {
            "ext-gd": "1"
        }
    }
}

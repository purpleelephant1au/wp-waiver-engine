{
    "name": "wp-waiver-engine/wp-waiver-engine",
    "description": "WordPress Waiver Engine – PDF overlay generation",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0",
        "freemius/wordpress-sdk": "^2.12",
        "setasign/fpdi": "^2.5",
        "setasign/fpdf": "^1.8"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true
    }
}
